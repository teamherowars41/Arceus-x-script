local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 Hub | BRM5 & AFK",
   LoadingTitle = "Menyiapkan Fitur Militer...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("BRM5 Farm", 4483362458)

-- Fitur Utama BRM5
Tab:CreateToggle({
   Name = "Auto Kill NPC (Silent Aim)",
   CurrentValue = false,
   Callback = function(Value)
      _G.AutoKill = Value
      while _G.AutoKill do
         pcall(function()
            for _, v in pairs(workspace.Enemies:GetChildren()) do
               if v:FindFirstChild("Head") and _G.AutoKill then
                  game:GetService("ReplicatedStorage").Events.Hit:FireServer(v.Head.Position, v.Head)
               end
            end
         end)
         task.wait(0.5)
      end
   end,
})

Tab:CreateButton({
   Name = "Enable No Recoil",
   Callback = function()
      for _, v in pairs(getgc(true)) do
         if type(v) == "table" and rawget(v, "Recoil") then
            v.Recoil = 0
            v.Spread = 0
         end
      end
   end,
})

Tab:CreateToggle({
   Name = "Ultra AFK Mode (Anti-Kick)",
   CurrentValue = false,
   Callback = function(Value)
      _G.AntiAFK = Value
      local vu = game:GetService("VirtualUser")
      game:GetService("Players").LocalPlayer.Idled:Connect(function()
         if _G.AntiAFK then
            vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
            wait(1)
            vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
         end
      end)
   end,
})
