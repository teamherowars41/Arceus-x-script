local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 Hub | CDID FULL AUTO",
   LoadingTitle = "Mengaktifkan Sistem Pengiriman Kilat...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("Full Farm", 4483362458)

-- FITUR UTAMA: FULL AUTO FLY TO WAYPOINT
Tab:CreateToggle({
   Name = "Aktifkan Full Auto Fly",
   CurrentValue = false,
   Callback = function(Value)
      _G.FullAuto = Value
      
      while _G.FullAuto do
         pcall(function()
            local player = game.Players.LocalPlayer
            local character = player.Character
            local vehicle = character.Humanoid.SeatPart.Parent
            
            -- Mencari Waypoint (Mencakup semua kemungkinan nama di CDID)
            local target = nil
            for _, obj in pairs(workspace:GetDescendants()) do
               if (obj.Name == "JobWaypoint" or obj.Name == "Waypoint" or obj.Name == "Target") and obj:IsA("BasePart") then
                  target = obj
                  break
               end
            end

            if vehicle and target then
               -- Ketinggian terbang 350 unit (Aman dari gunung di Jateng)
               local flyHeight = Vector3.new(0, 350, 0)
               local targetPos = target.Position + flyHeight
               
               -- Menggerakkan kendaraan ke target (CFrame Interpolation)
               vehicle:SetPrimaryPartCFrame(CFrame.new(vehicle.PrimaryPart.Position, targetPos))
               vehicle.PrimaryPart.CFrame = vehicle.PrimaryPart.CFrame * CFrame.new(0, 0, -20) -- Kecepatan ditingkatkan ke 20
               
               -- Matikan gravitasi kendaraan agar tidak jatuh saat terbang
               if not vehicle.PrimaryPart:FindFirstChild("BodyVelocity") then
                  local bv = Instance.new("BodyVelocity", vehicle.PrimaryPart)
                  bv.Velocity = Vector3.new(0,0,0)
                  bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
               end

               -- Jika sudah tepat di atas target, turunkan paksa
               local dist = (Vector2.new(vehicle.PrimaryPart.Position.X, vehicle.PrimaryPart.Position.Z) - Vector2.new(target.Position.X, target.Position.Z)).Magnitude
               if dist < 50 then
                  vehicle:SetPrimaryPartCFrame(CFrame.new(target.Position))
                  if vehicle.PrimaryPart:FindFirstChild("BodyVelocity") then
                     vehicle.PrimaryPart.BodyVelocity:Destroy()
                  end
                  Rayfield:Notify({Title = "Selesai", Content = "Sampai! Ambil job lagi."})
                  _G.FullAuto = false -- Off otomatis biar aman
               end
            end
         end)
         task.wait(0.01) -- Kecepatan refresh tinggi
      end
   end,
})

