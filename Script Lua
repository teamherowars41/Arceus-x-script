local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 Hub | CDID TYCOON",
   LoadingTitle = "Menghitung Pundi-Pundi Rupiah...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("Auto Farm V3", 4483362458)

-- VARIABEL STATISTIK
local startMoney = game.Players.LocalPlayer.leaderstats.Money.Value
local moneyEarned = 0

-- LABEL UNTUK TRACKER
local MoneyLabel = Tab:CreateLabel("Total Uang Didapat: Rp 0")
local StatusLabel = Tab:CreateLabel("Status: Menunggu Misi...")

-- UPDATE TRACKER SECARA OTOMATIS
spawn(function()
    while task.wait(1) do
        moneyEarned = game.Players.LocalPlayer.leaderstats.Money.Value - startMoney
        MoneyLabel:Set("Total Uang Didapat: Rp " .. tostring(moneyEarned))
    end
end)

-- FITUR TERBANG
_G.Height = 600 -- Lebih tinggi sesuai permintaan
_G.Speed = 60  -- Lebih cepat sesuai permintaan

Tab:CreateToggle({
   Name = "Super Fast Fly (No Lag)",
   CurrentValue = false,
   Callback = function(Value)
      _G.FullAuto = Value
      if Value then StatusLabel:Set("Status: Terbang ke Tujuan...") else StatusLabel:Set("Status: Idle") end
      
      while _G.FullAuto do
         pcall(function()
            local lp = game.Players.LocalPlayer
            local veh = lp.Character.Humanoid.SeatPart.Parent
            local target = workspace:FindFirstChild("JobWaypoint") or workspace:FindFirstChild("Waypoint")
            
            if veh and target then
               -- Efek terbang tinggi & cepat
               local targetPos = target.Position + Vector3.new(0, _G.Height, 0)
               veh:SetPrimaryPartCFrame(CFrame.new(veh.PrimaryPart.Position, targetPos))
               veh.PrimaryPart.CFrame = veh.PrimaryPart.CFrame * CFrame.new(0, 0, -_G.Speed)
               
               -- Anti-Gravitasi agar mulus
               if not veh.PrimaryPart:FindFirstChild("NoGravity") then
                  local bp = Instance.new("BodyPosition", veh.PrimaryPart)
                  bp.Name = "NoGravity"
                  bp.MaxForce = Vector3.new(0, 9e9, 0)
                  bp.Position = Vector3.new(0, _G.Height, 0)
               end

               -- Sampai di tujuan
               if (veh.PrimaryPart.Position - targetPos).Magnitude < 70 then
                  if veh.PrimaryPart:FindFirstChild("NoGravity") then veh.PrimaryPart.NoGravity:Destroy() end
                  veh:SetPrimaryPartCFrame(CFrame.new(target.Position))
                  _G.FullAuto = false
                  StatusLabel:Set("Status: Misi Selesai! Ambil Lagi.")
                  Rayfield:Notify({Title = "CUAN!", Content = "Uang berhasil masuk kantong!"})
               end
            end
         end)
         task.wait(0.01)
      end
   end,
})

Tab:CreateSection("Pengaturan Terbang")

Tab:CreateSlider({
   Name = "Ketinggian (Biar Ga Lag)",
   Range = {300, 1500},
   Increment = 50,
   CurrentValue = 600,
   Callback = function(V) _G.Height = V end,
})

Tab:CreateSlider({
   Name = "Kecepatan Terbang",
   Range = {20, 150},
   Increment = 5,
   CurrentValue = 60,
   Callback = function(V) _G.Speed = V end,
})
