local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 Hub | BRM5 God Mode",
   LoadingTitle = "Menyiapkan Amunisi Tak Terbatas...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("Auto Farm", 4483362458)

-- 1. UNLIMITED AMMO (FITUR BARU)
Tab:CreateButton({
   Name = "Enable Unlimited Ammo",
   Callback = function()
       -- Mencari modul senjata dan mengunci jumlah peluru
       for _, v in pairs(getgc(true)) do
           if type(v) == "table" and rawget(v, "Ammo") then
               v.Ammo = 999
               v.StoredAmmo = 999
           end
       end
       Rayfield:Notify({Title = "Ammo", Content = "Unlimited Ammo Aktif!"})
   end,
})

-- 2. FULL AUTO FARM (TP + KILL)
Tab:CreateToggle({
   Name = "Full Auto Farm (TP + Kill)",
   CurrentValue = false,
   Callback = function(Value)
      _G.FullFarm = Value
      while _G.FullFarm do
         pcall(function()
            for _, v in pairs(workspace.Enemies:GetChildren()) do
               if v:FindFirstChild("Head") and _G.FullFarm then
                  -- Teleport ke atas kepala musuh agar aman
                  game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.Head.CFrame * CFrame.new(0, 10, 0)
