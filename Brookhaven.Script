local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 Hub | FE TROLL",
   LoadingTitle = "Fixing Callback Errors...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("Brookhaven FE", 4483362458)

-- Fungsi Helper untuk Remote Brookhaven (Mencegah Error)
local function UpdateBrookhaven(prop, value)
    pcall(function()
        game:GetService("ReplicatedStorage").RemoteEvents.PropUpdate:FireServer("UpdateProp", prop, value)
    end)
end

-- 1. FE SIZE
Tab:CreateButton({
   Name = "Jadi Raksasa (FE)",
   Callback = function()
      UpdateBrookhaven("Size", 2.0)
   end,
})

Tab:CreateButton({
   Name = "Jadi Kurcaci (FE)",
   Callback = function()
      UpdateBrookhaven("Size", 0.3)
   end,
})

-- 2. FE SPEED
Tab:CreateSlider({
   Name = "Kecepatan Jalan",
   Range = {16, 150},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(Value)
      pcall(function()
          game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
      end)
   end,
})

-- 3. FE MUSIC (SCARY)
Tab:CreateInput({
   Name = "Play Music ID (Loud)",
   PlaceholderText = "ID Suara...",
   Callback = function(Text)
      UpdateBrookhaven("MusicID", "rbxassetid://"..tostring(Text))
   end,
})

-- 4. FE DIVINE LIGHT (VEHICLE)
Tab:CreateToggle({
   Name = "Mobil Cahaya Ilahi (FE)",
   CurrentValue = false,
   Callback = function(Value)
      _G.FE_Divine = Value
      while _G.FE_Divine do
         pcall(function()
            local char = game.Players.LocalPlayer.Character
            local veh = char.Humanoid.SeatPart.Parent
            if veh then
               for _, light in pairs(veh:GetDescendants()) do
                  if light:IsA("Light") then
                     light.Brightness = 1000
                     light.Range = 300
                     light.Enabled = true
                  end
               end
            end
         end)
         task.wait(0.5)
      end
   end,
})
