local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 | FE LOUD BYPASS",
   LoadingTitle = "Menghubungkan ke Remote Server...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("Audio Server", 4483362458)

-- FUNGSI UTAMA BYPASS (FE)
local function PlayFE(audioId)
    local finalId = "rbxassetid://" .. tostring(audioId):gsub("rbxassetid://", "")
    
    pcall(function()
        -- Trigger Remote Brookhaven
        game:GetService("ReplicatedStorage").RemoteEvents.PropUpdate:FireServer("UpdateProp", "MusicID", finalId)
    end)
    
    Rayfield:Notify({
        Title = "Audio Sent",
        Content = "ID: " .. audioId .. " berhasil dikirim ke server!",
        Duration = 3
    })
end

Tab:CreateSection("Custom Music (Input ID)")

Tab:CreateInput({
   Name = "Input Custom ID",
   PlaceholderText = "Masukkan ID Musik...",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      if Text ~= "" then PlayFE(Text) end
   end,
})

Tab:CreateSection("Koleksi Suara Seram (FE)")

-- DAFTAR 5 SUARA SERAM PILIHAN
local sounds = {
    {Name = "666 Ghost Scream (Loud)", ID = "1131102559"},
    {Name = "Kuntilanak Ketawa", ID = "1331256377"},
    {Name = "Siren Head Echo", ID = "5133642341"},
    {Name = "Whisper from Hell", ID = "145402035"},
    {Name = "Jumpscare Sound", ID = "6822216440"}
}

for _, s in pairs(sounds) do
    Tab:CreateButton({
        Name = s.Name,
        Callback = function()
            PlayFE(s.ID)
        end,
    })
end

Tab:CreateSection("Controls")

Tab:CreateButton({
   Name = "Hentikan Suara (Stop)",
   Callback = function()
      PlayFE("0")
   end,
})

Tab:CreateLabel("INFO: Wajib Duduk di Mobil agar terdengar 1 Server!")
