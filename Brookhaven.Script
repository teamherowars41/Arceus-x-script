local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 | FE BROOKHAVEN ALL-IN-ONE",
   LoadingTitle = "Menghapus Fitur Non-FE...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("FE Menu", 4483362458)

-- 1. FE SIZE CHANGER (Menjadi Raksasa atau Kurcaci)
Tab:CreateSection("Karakter (FE)")
Tab:CreateButton({
   Name = "Jadi Raksasa (FE)",
   Callback = function()
      game:GetService("ReplicatedStorage").RemoteEvents.PropUpdate:FireServer("UpdateProp", "Size", 2.0)
      Rayfield:Notify({Title = "Berhasil", Content = "Semua orang melihatmu menjadi besar!"})
   end,
})

Tab:CreateButton({
   Name = "Jadi Kurcaci (FE)",
   Callback = function()
      game:GetService("ReplicatedStorage").RemoteEvents.PropUpdate:FireServer("UpdateProp", "Size", 0.5)
   end,
})

-- 2. FE SPEED BYPASS (Terlihat orang lain lari kencang)
Tab:CreateSlider({
   Name = "Kecepatan Jalan (FE)",
   Range = {16, 100},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(Value)
      game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
   end,
})

-- 3. FE SCARY AUDIO (Satu server dengar)
Tab:CreateSection("Suara & Musik (FE)")
Tab:CreateInput({
   Name = "Play Music ID (Loud)",
   PlaceholderText = "Masukkan ID Suara...",
   Callback = function(Text)
      game:GetService("ReplicatedStorage").RemoteEvents.PropUpdate:FireServer("UpdateProp", "MusicID", "rbxassetid://"..Text)
   end,
})

-- 4. FE VEHICLE LIGHTS (Cahaya Ilahi Mobil - Paling Silau)
Tab:CreateSection("Kendaraan (FE)")
Tab:CreateToggle({
   Name = "Mobil Cahaya Ilahi (FE)",
   CurrentValue = false,
   Callback = function(Value)
      _G.FE_Lights = Value
      while _G.FE_Lights do
         pcall(function()
            local veh = game.Players.LocalPlayer.Character.Humanoid.SeatPart.Parent
            for _, light in pairs(veh:GetDescendants()) do
               if light:IsA("Light") then
                  light.Brightness = 500
                  light.Range = 200
                  light.Enabled = true
               end
            end
         end)
         task.wait(0.5)
      end
   end,
})

-- 5. FE TROLL NAMES (Ganti Bio secara otomatis)
Tab:CreateSection("Troll (FE)")
Tab:CreateInput({
   Name = "Ganti Bio/Nama (FE)",
   PlaceholderText = "Ketik sesuatu...",
   Callback = function(Text)
      game:GetService("ReplicatedStorage").RemoteEvents.PropUpdate:FireServer("UpdateProp", "Bio", Text)
   end,
})

-- 6. FE TELEPORT (Ke Rumah Orang)
Tab:CreateButton({
   Name = "Teleport ke Rumah 1",
   Callback = function()
      -- Teleport koordinat rumah (FE karena karaktermu berpindah posisi di server)
      game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-380, 20, 350)
   end,
})
