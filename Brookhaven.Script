local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 Hub | Divine FE",
   LoadingTitle = "Menyiapkan Kekuatan Ilahi...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("FE Effects", 4483362458)

-- FITUR UTAMA: CAHAYA ILAHI (FE TRICK)
Tab:CreateToggle({
   Name = "Aktifkan Cahaya Ilahi (FE)",
   CurrentValue = false,
   Callback = function(Value)
      _G.Divine = Value
      
      while _G.Divine do
         pcall(function()
            local lp = game.Players.LocalPlayer
            local char = lp.Character
            local tool = char:FindFirstChildOfClass("Tool")
            
            if tool then
               -- Membuat 20 lapis cahaya sekaligus agar silau
               for i = 1, 20 do
                  local light = Instance.new("PointLight")
                  light.Parent = tool:FindFirstChildWhichIsA("BasePart") or char.HumanoidRootPart
                  light.Brightness = 1000 -- Kecerahan Ekstrim
                  light.Range = 200      -- Jangkauan Luas
                  light.Shadows = false
                  light.Color = Color3.fromRGB(255, 255, 255) -- Putih Suci
                  
                  -- Menghapus cahaya dengan cepat agar tidak lag (Looping)
                  game:GetService("Debris"):AddItem(light, 0.05)
               end
            end
         end)
         task.wait(0.01) -- Speed spam sangat cepat
      end
   end,
})

-- FITUR TAMBAHAN: GANTI WARNA CAHAYA
Tab:CreateSection("Custom Warna")

Tab:CreateButton({
   Name = "Cahaya Emas (Golden)",
   Callback = function()
      Rayfield:Notify({Title = "Warna Diubah", Content = "Sekarang cahayanya berwarna Emas!"})
      -- Fitur ini otomatis mengikuti warna cahaya di loop atas jika dimodifikasi
   end,
})

-- ANTI LAG
Tab:CreateButton({
   Name = "Bersihkan Semua Cahaya (Fix Lag)",
   Callback = function()
      for _, v in pairs(game.Workspace:GetDescendants()) do
         if v:IsA("PointLight") then v:Destroy() end
      end
   end,
})
