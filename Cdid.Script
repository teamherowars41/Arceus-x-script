local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "teamherowars41 Hub | CDID PURE FLY",
   LoadingTitle = "Menyiapkan Engine Atomicals...",
   LoadingSubtitle = "by teamherowars41",
})

local Tab = Window:CreateTab("Truck Farm", 4483362458)

-- Pengaturan Global
_G.AutoFly = false
_G.FlySpeed = 100
_G.FlyHeight = 550

Tab:CreateSection("Auto Pilot")

Tab:CreateToggle({
   Name = "Aktifkan Auto Fly (Duduk di Supir)",
   CurrentValue = false,
   Callback = function(Value)
      _G.AutoFly = Value
      
      if Value then
         Rayfield:Notify({Title = "Sistem Aktif", Content = "Duduk di truk untuk mulai terbang ke tujuan!"})
      end

      -- Loop Engine Terbang (Metode Atomicals)
      while _G.AutoFly do
         task.wait()
         pcall(function()
            local lp = game.Players.LocalPlayer
            local char = lp.Character
            local hum = char:FindFirstChild("Humanoid")
            local seat = hum and hum.SeatPart
            
            -- Hanya jalan jika kita di kursi supir kendaraan
            if seat and seat.Parent then
               local veh = seat.Parent
               local root = veh.PrimaryPart
               
               -- Cari Waypoint aktif di Map
               local waypoint = nil
               for _, v in pairs(workspace:GetDescendants()) do
                  if (v.Name == "JobWaypoint" or v.Name == "Waypoint") and v:IsA("BasePart") then
                     waypoint = v
                     break
                  end
               end

               if root and waypoint then
                  -- Ketinggian aman di atas waypoint
                  local targetPos = waypoint.Position + Vector3.new(0, _G.FlyHeight, 0)
                  
                  -- ATOMICALS SMOOTH LERP (Terbang Mulus)
                  root.CFrame = root.CFrame:Lerp(CFrame.new(root.Position, targetPos) * CFrame.new(0, 0, -_G.FlySpeed/10), 0.15)
                  
                  -- Anti-Gravitasi (BodyForce agar stabil)
                  if not root:FindFirstChild("FlightForce") then
                     local bf = Instance.new("BodyForce", root)
                     bf.Name = "FlightForce"
                     bf.Force = Vector3.new(0, workspace.Gravity * root:GetMass(), 0)
                  end
                  
                  -- Sistem Landing (Mendarat Otomatis)
                  local dist = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(waypoint.Position.X, waypoint.Position.Z)).Magnitude
                  if dist < 70 then
                     if root:FindFirstChild("FlightForce") then root.FlightForce:Destroy() end
                     root.CFrame = CFrame.new(waypoint.Position + Vector3.new(0, 2, 0))
                     task.wait(2) -- Jeda agar gaji masuk
                  end
               end
            end
         end)
      end
   end,
})

Tab:CreateSection("Settings")

Tab:CreateSlider({
   Name = "Kecepatan Terbang",
   Range = {50, 300},
   Increment = 10,
   CurrentValue = 100,
   Callback = function(v) _G.FlySpeed = v end,
})

Tab:CreateSlider({
   Name = "Ketinggian (Height)",
   Range = {300, 1000},
   Increment = 50,
   CurrentValue = 550,
   Callback = function(v) _G.FlyHeight = v end,
})

Tab:CreateSection("Extra")

Tab:CreateButton({
   Name = "Bypass Speed Limit Truk",
   Callback = function()
      pcall(function()
         local car = game.Players.LocalPlayer.Character.Humanoid.SeatPart.Parent
         if car:FindFirstChild("DriveValues") then
             car.DriveValues.MaxSpeed.Value = 1000
         end
      end)
   end,
})

Tab:CreateButton({
   Name = "Anti-AFK",
   Callback = function()
      local vu = game:GetService("VirtualUser")
      game.Players.LocalPlayer.Idled:Connect(function()
         vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
         wait(1)
         vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
      end)
      Rayfield:Notify({Title = "Anti-AFK", Content = "Sudah Aktif!"})
   end,
})
               if dist < 75 then
                  if root:FindFirstChild("FlightForce") then root.FlightForce:Destroy() end
                  root.CFrame = CFrame.new(waypoint.Position + Vector3.new(0, 2, 0))
                  task.wait(1.5) -- Tunggu gaji masuk
               end
            end
         end)
      end
   end,
})

Tab:CreateSection("Settings")

Tab:CreateSlider({
   Name = "Fly Speed",
   Range = {50, 250},
   Increment = 10,
   CurrentValue = 100,
   Callback = function(v) _G.FlySpeed = v end,
})

Tab:CreateSlider({
   Name = "Fly Height",
   Range = {300, 1000},
   Increment = 50,
   CurrentValue = 550,
   Callback = function(v) _G.FlyHeight = v end,
})
Tab:CreateButton({
   Name = "Anti-Afk (Stable)",
   Callback = function()
      local vu = game:GetService("VirtualUser")
      game.Players.LocalPlayer.Idled:Connect(function()
         vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
         wait(1)
         vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
      end)
   end,
})
